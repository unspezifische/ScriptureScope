{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scripturescope.example/schemas/model-metadata.schema.json",
  "title": "ScriptureScope dataset metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "displayName",
    "description",
    "calculation",
    "methodType",
    "bibleVersion",
    "corpusVersion",
    "representation",
    "relationship",
    "layout",
    "artifacts",
    "generatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "calculation": {
      "type": "string",
      "minLength": 40
    },
    "methodType": {
      "type": "string",
      "enum": ["analysis", "layout", "analysis-and-layout"]
    },
    "bibleVersion": {
      "type": "string",
      "minLength": 1
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "representation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 40 },
        "parameters": { "type": "object" }
      }
    },
    "relationship": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "version", "metric", "scoreKind", "scoreDirection", "linkRule"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "metric": { "type": "string", "minLength": 1 },
            "scoreKind": { "enum": ["distance", "similarity"] },
            "scoreDirection": { "enum": ["lower-is-closer", "higher-is-closer"] },
            "linkRule": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "distanceMeaning"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "distanceMeaning": { "type": "string", "minLength": 40 },
        "parameters": { "type": "object" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "required": ["nodesSha256", "linksSha256"],
      "properties": {
        "nodesSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "linksSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "parameters": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
